# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated artifacts and run data.
# Every file under demo/ and case/ is either a small authored input (scripts, README,
# SLURM files, frozen CSV/JSON results) or a regenerable simulation output. Outputs are
# ignored by two conventions:
#   1. run-tree directories by name (output*/, runs*/, archive/, frames/);
#   2. regenerable file types, scoped to demo/** and case/** only — geometry inputs
#      live in test/assets/ and are never matched.
demo/**/output*/
case/**/output*/
demo/**/runs*/
case/**/runs*/
demo/**/archive/
case/**/archive/
demo/**/frames/
case/**/frames/
case/drainage/gen_rock/
demo/imbibition/sphere/
demo/**/*.h5
case/**/*.h5
demo/**/*.xdmf
case/**/*.xdmf
demo/**/*.npz
case/**/*.npz
demo/**/*.npy
case/**/*.npy
demo/**/*.gif
case/**/*.gif
demo/**/*.raw
case/**/*.raw
demo/**/*.log
case/**/*.log
demo/**/*.svg
case/**/*.svg
demo/**/*.png
case/**/*.png
demo/**/*.pdf
case/**/*.pdf

# Campaign launch files (regenerated by case/submit_phase.py)
case/_manifests/
case/_logs/

# Local scratch and tooling
/output.log
.claude/
.agents/
.codex/
.superpowers/
testbed/
repo/
data_arch/
